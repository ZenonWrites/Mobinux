# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit it.

# Required. A long random string — generate with: openssl rand -hex 32
CONTROL_API_KEY=

# Optional. Seeds the initial service list on first run only; after
# that, services are managed from the app itself and stored in
# SERVICES_FILE below. Format: "Display Name:unit-name,Other:other-unit"
SERVICES=My Service:my-service

# Optional. Where the phone-editable service list is persisted.
SERVICES_FILE=/var/lib/ec2-control/services.json

# Optional. Shared "current directory" used by custom commands and the
# file browser.
CWD_FILE=/var/lib/ec2-control/cwd
DEFAULT_CWD=/home/ubuntu

# Optional. Max seconds a single custom command may run before timeout.
CUSTOM_COMMAND_TIMEOUT=60

# Optional, watchdog only. A random, unguessable ntfy.sh topic name for
# push notifications — do not reuse a guessable name, anyone who knows
# the topic can read your notifications.
NTFY_TOPIC=
