/* Allows the "ubuntu" user to start/stop/restart systemd units without
   the "interactive authentication required" error — needed because the
   control API runs as a background service, not a logged-in session. */
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "ubuntu") {
        return polkit.Result.YES;
    }
});
